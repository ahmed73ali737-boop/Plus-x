# PulseX local profile example; NOT auto-loaded by application.
PULSEX_ENV=local
SEED_DEMO=true
HOST=127.0.0.1
PORT=4310
PUBLIC_ORIGIN=http://127.0.0.1:4310
DATABASE_URL=sqlite:///./data/pulsex-pilot.sqlite3
DATA_DIR=data
MEDIA_DIR=data/media
CREDENTIALS_PATH=data/first-run-accounts.json
BACKUP_DIR=backups
WEB_WORKERS=1

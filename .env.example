# Use an owned domain pointed at the Linux host. These values are not credentials.
DOMAIN=pilot.example.com
# Use only a randomly generated hex string here to avoid URI-encoding issues.
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Separate server-side key used to derive non-enumerable guest/phone identity digests.
GUEST_ID_SECRET=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_CHARACTERS

# Start with 2-4 workers on a modest host; validate under load before increasing.
WEB_WORKERS=4

# First production platform administrator. Used only when the database is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# Release-evidence flags. Keep false until the matching acceptance report is signed.
PX_NATIVE_POSTGRES_ACCEPTED=false
PX_LOAD_ACCEPTED=false
PX_SECURITY_ACCEPTED=false
PX_FIELD_OFFLINE_ACCEPTED=false

# Certificates V3: explicit staged activation; saved deliveries work with both flags off.
PX_SELF_CERTIFICATES_ADMIN=false
PX_SELF_CERTIFICATES_ACCEPT_NEW=false
# Empty pilot scope means all otherwise eligible accounts/events once enabled.
PX_SELF_CERTIFICATE_PILOT_ACCOUNTS=
PX_SELF_CERTIFICATE_PILOT_EVENTS=
# One elected group across ASGI workers; global render slots remain capped at six.
PX_SELF_CERTIFICATE_WORKERS=6
PX_SELF_CERTIFICATE_RENDER_CONCURRENCY=6
PX_SELF_CERTIFICATE_RENDER_EXECUTOR=supervisor
PX_SELF_CERTIFICATE_MIN_FREE_BYTES=268435456
# Trust only the actual reverse proxy IP/CIDR. Never use '*'.
# Loopback is safe for direct local access; configure the proxy address before a pilot.
FORWARDED_ALLOW_IPS=127.0.0.1

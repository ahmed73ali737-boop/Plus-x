    {
      "id": "AUDIT-GUEST-ATOMIC-DIRECT",
      "status": "regression_required",
      "invariant": "A rejected direct guest registration must leave zero guest/event-registration side effects.",
      "checks": [
        {
          "path": "tests/test_windows12_guests.py",
          "markers": [
            "test_invalid_pass_token_registration_has_no_side_effects",
            "PASS_TOKEN_INVALID"
          ]
        }
      ]
    },
    {
      "id": "AUDIT-GUEST-ATOMIC-SYNC",

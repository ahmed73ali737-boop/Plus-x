# Import these sites into the existing edge configuration. Caddy obtains and
# renews public HTTPS certificates for both names automatically.
eventna.app {
    encode gzip
    reverse_proxy eventna-app:4310
}

www.eventna.app {
    redir https://eventna.app{uri} 308
}


  "test_scenarios": [
    {
      "name": "الزائر الجديد",
      "role": "visitor",
      "steps": [
        "افتح الصفحة الرئيسية (public.platform)",
        "استكشف الفعاليات المتاحة",
        "افتح فعالية معينة (public.event)",
        "تحقق من شهادة (cert.verify)"
      ]
    },
    {
      "name": "ضيف الفعالية",
      "role": "guest",

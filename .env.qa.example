# PulseX QA example; never reuse a production database.
PULSEX_ENV=test
SEED_DEMO=false
HOST=127.0.0.1
PORT=4310
PUBLIC_ORIGIN=http://127.0.0.1:4310
DATABASE_URL=sqlite:///./data/qa.sqlite3
DATA_DIR=data/qa
WEB_WORKERS=1
# PostgreSQL tests additionally require dedicated PX_POSTGRES_TEST_URL and
# PX_ALLOW_POSTGRES_TEST_RESET=YES. Never point these at production.
